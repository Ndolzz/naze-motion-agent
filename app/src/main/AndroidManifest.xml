<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Phase 27: floating progress card over the target app during a run. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />


    <!-- Android 11+ package visibility: without these queries the app
         cannot see Alight Motion / CapCut and reports them as not
         installed even when they are. -->
    <queries>
        <package android:name="com.alightcreative.motion" />
        <package android:name="com.alightcreative.motion.trial" />
        <package android:name="com.lemon.lvoverseas" />
        <package android:name="com.lemon.lv" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.NazeMotion"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 20: shares an exported run log file with the system
             share sheet without granting broad storage access. The
             accessibility service is declared by the core/access library
             manifest and merged in at build time. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.naze.motion.agent.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Phase 27: floating progress card drawn over the target app. -->
        <service
            android:name="com.naze.motion.app.agent.RunOverlayService"
            android:exported="false" />
    </application>
</manifest>
